---
import { countries, tools } from '../data/catalogue';
---
<section id="countries" class="country-section" aria-labelledby="countries-title"><div class="section-heading"><div><p class="eyebrow">Start with where you live</p><h2 id="countries-title">Your country. Your calculation.</h2></div><p class="section-caption">US, UK, UAE and India tools have limited betas.<br />Other collections show the build plan.</p></div><div class="country-grid">{countries.map(country => <a class="country-card" href={`/${country.code}/`}><span class="country-code">{country.short}</span><span><h3>{country.name}</h3><p>{country.description}</p><span class="country-availability">{tools.some(tool => tool.country === country.code && tool.availability === 'beta') ? 'Limited beta available' : 'Tools in preparation'}</span></span><span class="arrow" aria-hidden="true">↗</span></a>)}</div></section>
