---
import Base from '../../layouts/Base.astro';
import GuidedFinder from '../../components/GuidedFinder';
import Icon from '../../components/Icon.astro';
import { countries, tools, type CountryCode } from '../../data/catalogue';
export function getStaticPaths() { return countries.map(country => ({ params: { country: country.code }, props: { country } })); }
const { country } = Astro.props;
const collection = tools.filter(tool => tool.country === country.code);
---
<Base title={`${country.name} pay, tax & benefits calculators | CalcsDesk`} description={`Explore the ${country.name} calculator collection. ${country.description}. See the intended inputs, working and source references.`} breadcrumb={country.name}>
  <section class="country-hero"><div><p class="eyebrow">{country.short} / The calculator desk</p><h1>{country.name}<br /> <span class="accent">calculators.</span></h1><p class="lead">{country.intro}</p><div class="country-context"><span class="micro">Local context matters</span><strong>{country.description}</strong><p>Explore the collection below, or use the finder to choose your next step.</p></div></div><GuidedFinder countryCode={country.code as CountryCode} client:load /></section>
  <section class="country-collection" aria-labelledby="collection-title"><div class="section-heading"><div><p class="eyebrow">The calculator collection</p><h2 id="collection-title">A clearer route to your calculation.</h2></div><span class="status-tag">{collection.some(tool => tool.availability === 'beta') ? 'Beta available' : 'Bracket preview available'}</span></div><div class="tool-plans">{collection.map(tool => <article class="tool-plan" id={tool.id}><div class="tool-plan-heading"><span class="tool-icon"><Icon name={tool.task} /></span><div><span class="micro">{tool.task} / {country.short}</span><h3>{tool.name}</h3></div></div><p>{tool.description}</p><ul class="scope-list">{tool.scope.map(scope => <li>{scope}</li>)}</ul>{tool.availability === 'beta' ? <div class="preparation-note"><strong>Interactive beta</strong><p>See the tool for its inputs, supported cases, official sources and review status.</p><a class="primary-button" href={tool.path}>Open calculator →</a></div> : <div class="preparation-note"><strong>Full calculator in preparation</strong><p>This tool needs sourced rate data and tested worked examples before it can show a full estimate.</p>{tool.id === 'paycheck' && <a class='text-link' href={tool.path}>Open the federal withholding preview</a>}{country.code === 'ca' && <a class="text-link" href={tool.path}>Open the federal and regional bracket preview</a>}{country.code === 'au' && tool.id === 'pay' && <a class="text-link" href={tool.path}>Open the resident income tax bracket preview</a>}</div>}<a class="text-link" href={`/sources/#${country.code}`}>Official reference sources ↗</a></article>)}</div></section>
  {country.code === "us" && <p><a href="/us/pay/">US paycheck directory</a> · <a href="/us/tax/">US federal tax tools</a></p>}
  {country.code === "ca" && <p><a href="/ca/tax/">Canadian income tax directory</a></p>}
  {country.code === "uk" && <p><a href="/uk/pay/">UK salary tools</a></p>}
  <section class="country-followup"><div><p class="eyebrow">Behind the calculation</p><h2>A number you can inspect.</h2><p>Inputs, formulas, rounding and limitations will sit alongside the result. A verification date will appear only after the underlying rates have been checked.</p><a class="text-link" href="/methodology/">See the approach →</a></div><aside><span class="micro">Looking somewhere else?</span><h3>Choose another country.</h3><div class="other-countries">{countries.filter(item => item.code !== country.code).map(item => <a href={`/${item.code}/`}>{item.name} <span aria-hidden="true">↗</span></a>)}</div></aside></section>
</Base>
