---
import Base from '../layouts/Base.astro';
import { countries } from '../data/catalogue';
---
<Base title="Official calculator reference sources | CalcsDesk" description="Official reference starting points for the planned CalcsDesk tools in the United States, UK, Canada, Australia, UAE and India." breadcrumb="Sources">
  <section class="page-intro"><p class="eyebrow">Look behind the number</p><h1>Start with the source.</h1><p class="lead">Official reference starting points for the planned tools. The federal beta has a dated rate table on its calculation page. The other links remain reference starting points, not verified rate tables.</p></section><div class="source-grid">{countries.map(country => <article class="source-card" id={country.code}><span class="micro">{country.short} / Official reference</span><h2>{country.name}</h2><p>{country.publisher}</p><a class="text-link" href={country.source} target="_blank" rel="noopener noreferrer">Visit official source <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a><p class="source-status">{country.code === 'us' ? 'Federal beta: official-source check 2 Nov 2026; human review pending' : 'Rate verification: pending'}</p></article>)}</div><div class="bottom-callout"><p>Want to know how sources will be used?</p><a class="text-link" href="/methodology/">Read the methodology →</a></div>
</Base>
