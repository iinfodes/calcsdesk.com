---
import Base from '../layouts/Base.astro';
import { countries, tools } from '../data/catalogue';
---
<Base title="Official calculator reference sources | CalcsDesk" description="Official reference starting points for the planned CalcsDesk tools in the United States, UK, Canada, Australia, UAE and India." breadcrumb="Sources">
  <section class="page-intro"><p class="eyebrow">Look behind the number</p><h1>Start with the source.</h1><p class="lead">Official reference starting points for the collection. US federal, UK monthly-salary, UAE gratuity and India salary-regime betas have their own dated source records and scope notes. A country reference link alone is not a verified rate table.</p></section><div class="source-grid">{countries.map(country => <article class="source-card" id={country.code}><span class="micro">{country.short} / Official reference</span><h2>{country.name}</h2><p>{country.publisher}</p><a class="text-link" href={country.source} target="_blank" rel="noopener noreferrer">Visit official source <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a><p class="source-status">{tools.some(tool => tool.country === country.code && tool.availability === 'beta') ? 'Limited beta: official-source check 2 Nov 2026; human review pending' : 'Public calculator rate verification: pending'}</p>{tools.filter(tool => tool.country === country.code && tool.availability === 'beta').map(tool => <a class="text-link" href={tool.path}>Read {tool.name.toLowerCase()} scope and sources →</a>)}</article>)}</div><div class="bottom-callout"><p>Want to know how sources will be used?</p><a class="text-link" href="/methodology/">Read the methodology →</a></div>
</Base>
